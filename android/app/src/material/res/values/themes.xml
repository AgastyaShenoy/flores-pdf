<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Material 3, light or dark by the system or the app's setting. On Android 12 and later the
         colors come from the wallpaper (DynamicColors in FloresApp), else from the icon's teal. -->
    <style name="Theme.Flores" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/teal_primary</item>
        <item name="colorOnPrimary">@color/teal_on_primary</item>
        <item name="colorPrimaryContainer">@color/teal_container</item>
        <item name="colorOnPrimaryContainer">@color/teal_on_container</item>
        <item name="colorSecondaryContainer">@color/teal_container</item>
        <item name="colorOnSecondaryContainer">@color/teal_on_container</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!-- The Black theme: dark, with black and near-black surfaces for OLED screens. -->
    <style name="ThemeOverlay.Flores.Black" parent="">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:colorBackground">@android:color/black</item>
        <item name="colorSurface">@android:color/black</item>
        <item name="colorSurfaceContainerLowest">@android:color/black</item>
        <item name="colorSurfaceContainerLow">#FF0A0B0B</item>
        <item name="colorSurfaceContainer">#FF101212</item>
        <item name="colorSurfaceContainerHigh">#FF161818</item>
        <item name="colorSurfaceContainerHighest">#FF1C1F1F</item>
    </style>

    <!-- Section headings in settings and sheets. -->
    <style name="TextAppearance.Flores.Section" parent="TextAppearance.Material3.TitleSmall">
        <item name="android:textColor">?attr/colorPrimary</item>
    </style>
</resources>
